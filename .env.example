# ============================
# Smilbot Backend - Environment
# ============================

# Server
PORT=3000
URL_DB=mongodb://localhost:27017/smilbot

# ---- Autenticación (obligatorio) ----
# Secreto para firmar los JWT de usuario. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# API key compartida con el bot de Discord (header: Authorization: Bot <BOT_API_KEY>).
# NO es el token de Discord del bot; genera un valor aleatorio igual que JWT_SECRET.
BOT_API_KEY=
# Discord IDs (separados por comas) con permisos de administrador desde el frontend
ADMIN_DISCORD_IDS=

# ---- OAuth2 Discord (login del frontend) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Debe coincidir exactamente con un Redirect URI registrado en el Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Origen del frontend: activa CORS con credenciales y la protección CSRF por Origin
FRONTEND_URL=http://localhost:5173
# Cookies de sesión. COOKIE_SECURE por defecto es true si NODE_ENV=production.
# Usa COOKIE_SAMESITE=none (con COOKIE_SECURE=true) si frontend y API están en dominios distintos.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Image provider: 'local' | 'cloudinary' | 'supabase'
IMAGE_PROVIDER=local

# ---- Local provider ----
IMAGE_HOST=http://localhost:3000

# ---- Cloudinary (required if IMAGE_PROVIDER=cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smilbot

# ---- Supabase Storage (required if IMAGE_PROVIDER=supabase) ----
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=smilbot-images
